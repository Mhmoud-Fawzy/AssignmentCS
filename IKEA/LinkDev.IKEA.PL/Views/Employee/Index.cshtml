@model IEnumerable<EmployeeDto>
@using LinkDev.IKEA.DAL.Common.Enums

@{
    ViewData["Title"] = "Employees";
    ViewBag.Controller = "Employee";
}

@functions{
    // Method to get EmployeeType Display Name
    public string GetEmployeeTypeDisplayName(string employeeType)
    {
        return employeeType switch
        {
            "FullTime" => "Full-Time",
            "PartTime" => "Part-Time",
            "Contract" => "Contract",
            _ => employeeType // Default to the raw value if no match
        };
    }

    // Method to get Gender Display Name
    public string GetGenderDisplayName(string gender)
    {
        return gender switch
        {
            "Male" => "Male",
            "Female" => "Female",
            "Other" => "Other",
            _ => gender // Default to the raw value if no match
        };
    }
}

<h1>Employees</h1>
<br />
<br />

<a asp-controller="Employee" asp-action="Create" class="btn btn-primary"> Create New Employee</a>

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(D => D.Name)</th>
                <th>@Html.DisplayNameFor(D => D.Email)</th>
                <th>@Html.DisplayNameFor(D => D.Department)</th>
                <th>@Html.DisplayNameFor(D => D.EmployeeType)</th>
                <th>@Html.DisplayNameFor(D => D.Age)</th>
                <th>@Html.DisplayNameFor(D => D.Salary)</th>
                <th>@Html.DisplayNameFor(D => D.IsActive)</th>
                <th>@Html.DisplayNameFor(D => D.Gender)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>@employee.Department</td>
                    <td>@GetEmployeeTypeDisplayName(employee.EmployeeType)</td>
                    <td>@employee.Age</td>
                    <td>@employee.Salary</td>
                    <td>@employee.IsActive</td>
                    <td>@GetGenderDisplayName(employee.Gender)</td> 
                    <partial name="_ButtonsPartial" model="@employee.Id" />
                </tr>

                <!-- Modal with unique ID -->
                <div class="modal fade" id="deleteModal-@employee.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@employee.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="deleteModalLabel-@employee.Id">Delete @employee.Name from Employees</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this employee?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-route-id="@employee.Id" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h3>There is No Employees</h3>
    </div>
}
