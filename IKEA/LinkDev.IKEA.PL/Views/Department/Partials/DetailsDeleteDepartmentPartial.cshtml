@model DepartmentDetailsDto

<ul class="nav nav-tabs mt-4" id="departmentTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="general-tab" data-bs-toggle="tab" href="#general" role="tab">General</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="admin-tab" data-bs-toggle="tab" href="#admin" role="tab">Administration</a>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4" id="myTabContent">
    <div class="tab-pane fade show active" id="general" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="CreationDate" class="form-label"></label>
                <input asp-for="CreationDate" class="form-control" readonly />
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="admin" role="tabpanel">
        <div class="row g-3 mt-3">
            <div class="col-md-6">
                <label asp-for="CreatedBy" class="form-label"></label>
                <input asp-for="CreatedBy" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="CreatedOn" class="form-label"></label>
                <input asp-for="CreatedOn" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="LastModifiedBy" class="form-label"></label>
                <input asp-for="LastModifiedBy" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="LastModifiedOn" class="form-label"></label>
                <input asp-for="LastModifiedOn" class="form-control" readonly />
            </div>
        </div>
    </div>

    <div class="mt-4">
        @if (ViewBag.Title == "Details")
        {
            <a asp-action="@ViewBag.Action" asp-route-id="@ViewBag.Id" class="btn btn-success">@ViewBag.Title</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        }
        else
        {
            <form asp-action="Delete" asp-route-id="@ViewBag.Id">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        }
    </div>
</div>
