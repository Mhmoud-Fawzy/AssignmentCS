@model IEnumerable<DepartmentDto>

@{
    ViewData["Title"] = "Index";
}

<h1>All Departments</h1>

<a asp-controller="Department" asp-action="Create" class="btn btn-primary my-3">Create Department</a>

@if (Model.Any())
{
    <table class="table mt-2">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().Code)</th>
                <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                <th>@Html.DisplayNameFor(m => m.First().Description)</th>
                <th>@Html.DisplayNameFor(m => m.First().CreatedOn)</th>
                <th scope="col">Details</th>
                <th scope="col">Update</th>
                <th scope="col">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Code</td>
                    <td>@d.Name</td>
                    <td>@d.Description</td>
                    <td>@d.CreatedOn</td>
                    <td>
                        <a class="btn btn-primary" asp-controller="Department" asp-action="Details" asp-route-id="@d.DeptId">
                            <i class="fas fa-eye"></i> Details
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-success" asp-controller="Department" asp-action="Edit" asp-route-id="@d.DeptId">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                    </td>
                    <td>
                        <a class="btn btn-danger" asp-controller="Department" asp-action="Delete" asp-route-id="@d.DeptId">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">No departments found.</div>
}
