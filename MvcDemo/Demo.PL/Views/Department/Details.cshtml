@model DepartmentDetailsDto

@{
    ViewData["Title"] = "Department Details";
}

<h2>Department Details</h2>

<div class="card">
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#general">General</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#admin">Administration</a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="general">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Code</label>
                        <input class="form-control" value="@Model.Code" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input class="form-control" value="@Model.Name" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input class="form-control" value="@Model.Description" readonly />
                </div>

                <div class="mb-4">
                    <label class="form-label">DateOfCreation</label>
                    <input class="form-control" value="@Model.CreatedOn?.ToShortDateString()" readonly />
                </div>
            </div>

            <div class="tab-pane fade" id="admin">
                <div class="mb-3">
                    <label class="form-label">Created By</label>
                    <input class="form-control" value="@Model.CreatedBy" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Last Modified By</label>
                    <input class="form-control" value="@Model.LastModifiedBy" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Is Deleted</label>
                    <input class="form-control" value="@(Model.IsDelated ? "Yes" : "No")" readonly />
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.DeptId" class="btn btn-success px-4">Edit</a>
            <a asp-action="Index" class="btn btn-secondary px-4">Back To list</a>
        </div>
    </div>
</div>
